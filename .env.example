# PostgreSQL connection (matches docker-compose defaults)
DATABASE_URL=postgresql://classroom:classroom_pass@localhost:5432/classroom_db

# Redis connection (matches docker-compose defaults)
REDIS_URL=redis://localhost:6379

# OpenAI — used for Whisper transcription AND GPT-4o-mini summarization
OPENAI_API_KEY=sk-...

# Express server port
PORT=3001

# URL the browser uses to reach the Express/Socket.io server
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# (optional) restrict CORS to your Next.js origin
FRONTEND_URL=http://localhost:3000

# Argument Map: independent model request using the saved discussion transcripts
ARGUMENT_MAP_MODEL=gpt-4o-mini
# Required for protected demo endpoint. Use a long random secret; never commit the real value.
ARGUMENT_MAP_ACCESS_TOKEN=replace-with-a-long-random-secret
