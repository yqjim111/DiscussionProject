# PostgreSQL connection (matches docker-compose defaults)
DATABASE_URL=postgresql://classroom:classroom_pass@localhost:5432/classroom_db

# Redis connection (matches docker-compose defaults)
REDIS_URL=redis://localhost:6379

# OpenAI — used for Whisper transcription AND GPT-4o-mini summarization
OPENAI_API_KEY=sk-...

# Optional backend transcription settings. Keep whisper-1 unless intentionally changing models.
TRANSCRIPTION_MODEL=whisper-1
# Set the actual spoken language (e.g. en or zh), or auto to omit the language hint.
TRANSCRIPTION_LANGUAGE=en

# Express server port
PORT=3001

# URL the browser uses to reach the Express/Socket.io server
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# (optional) restrict CORS to your Next.js origin
FRONTEND_URL=http://localhost:3000

# Instructor authentication on the Express backend (set a non-default PIN for shared deployments).
# The existing Instructor Portal asks for this PIN once; Argument Map needs no extra token.
INSTRUCTOR_PIN=replace-with-an-instructor-pin

# Argument Map analysis model. The room's saved topic, instructions and original transcript are used.
ARGUMENT_MAP_MODEL=gpt-4o-mini
